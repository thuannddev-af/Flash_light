<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/size16"
        android:orientation="vertical">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/size190"
            android:background="@drawable/bg_ad">
            <com.kt.flash.light.led.banner.customview.LedBannerView
                android:id="@+id/led_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/size12"
                android:contentDescription="@string/led"/>
            <ImageButton
                android:id="@+id/led_full_screen"
                android:layout_width="@dimen/size48"
                android:layout_height="@dimen/size48"
                android:layout_gravity="top|end"
                android:src="@drawable/ic_full"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/full_screen"/>
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size20"
            android:padding="@dimen/size20"
            android:orientation="vertical"
            android:background="@drawable/bg_ad">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/led_text"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_size_14"/>
            <EditText
                android:id="@+id/led_input"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size48"
                android:layout_marginTop="@dimen/size16"
                android:background="@drawable/bg_led_input"
                android:paddingStart="@dimen/size16"
                android:paddingEnd="@dimen/size16"
                android:text="@string/hello_world"
                android:hint="@string/led_text"
                android:textColor="#FFFFFF"
                android:textColorHint="#C1C7D0"
                android:textSize="@dimen/text_size_16"
                android:inputType="textCapSentences"
                android:maxLength="200"
                android:singleLine="true"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size20"
            android:padding="@dimen/size20"
            android:orientation="vertical"
            android:background="@drawable/bg_ad">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/font_size"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/text_size_14"/>
                <TextView
                    android:id="@+id/font_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFD54F"
                    android:textSize="@dimen/text_size_14"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/font_slider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size40"
                android:max="104"
                android:progress="40"
                android:thumb="@drawable/ic_control"
                android:splitTrack="false"
                android:progressTint="#FFD54F"
                android:progressBackgroundTint="#36394A"
                android:contentDescription="@string/font_size"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/scroll_speed"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/text_size_14"/>
                <TextView
                    android:id="@+id/speed_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFD54F"
                    android:textSize="@dimen/text_size_14"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/speed_slider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size40"
                android:max="19"
                android:progress="4"
                android:thumb="@drawable/ic_control"
                android:splitTrack="false"
                android:progressTint="#FFD54F"
                android:progressBackgroundTint="#36394A"
                android:contentDescription="@string/scroll_speed"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size20"
            android:padding="@dimen/size20"
            android:orientation="vertical"
            android:background="@drawable/bg_ad">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/led_color"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_size_14"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size16"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageButton
                        android:id="@+id/custom_color"
                        android:layout_width="@dimen/size42"
                        android:layout_height="@dimen/size42"
                        android:src="@drawable/ic_color"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/pick_color"/>
                    <View
                        android:id="@+id/color_cyan"
                        android:layout_width="@dimen/size42"
                        android:layout_height="@dimen/size42"
                        android:layout_marginStart="@dimen/size12"
                        android:background="@drawable/bg_led_color_cyan"
                        android:contentDescription="@string/color_cyan"
                        android:clickable="true"
                        android:focusable="true"/>
                    <View
                        android:id="@+id/color_white"
                        android:layout_width="@dimen/size42"
                        android:layout_height="@dimen/size42"
                        android:layout_marginStart="@dimen/size12"
                        android:background="@drawable/bg_led_color_white"
                        android:contentDescription="@string/color_white"
                        android:clickable="true"
                        android:focusable="true"/>
                    <View
                        android:id="@+id/color_yellow"
                        android:layout_width="@dimen/size42"
                        android:layout_height="@dimen/size42"
                        android:layout_marginStart="@dimen/size12"
                        android:background="@drawable/bg_led_color_yellow"
                        android:contentDescription="@string/color_yellow"
                        android:clickable="true"
                        android:focusable="true"/>
                    <View
                        android:id="@+id/color_green"
                        android:layout_width="@dimen/size42"
                        android:layout_height="@dimen/size42"
                        android:layout_marginStart="@dimen/size12"
                        android:background="@drawable/bg_led_color_green"
                        android:contentDescription="@string/color_green"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size8">
                    <View
                        android:id="@+id/color_purple"
                        android:layout_width="@dimen/size42"
                        android:layout_height="@dimen/size42"
                        android:layout_marginStart="@dimen/size12"
                        android:background="@drawable/bg_led_color_purple"
                        android:contentDescription="@string/color_purple"
                        android:clickable="true"
                        android:focusable="true"/>
                    <View
                        android:id="@+id/color_red"
                        android:layout_width="@dimen/size42"
                        android:layout_height="@dimen/size42"
                        android:layout_marginStart="@dimen/size12"
                        android:background="@drawable/bg_led_color_red"
                        android:contentDescription="@string/color_red"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size20"
            android:padding="@dimen/size20"
            android:orientation="vertical"
            android:background="@drawable/bg_ad">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/direction"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_size_14"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size16">
                <ImageButton
                    android:id="@+id/direction_right"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/size56"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/size0"
                    android:padding="@dimen/size20"
                    android:src="@drawable/ic_led_right"
                    android:background="@drawable/bg_led_direction"
                    android:contentDescription="@string/direction_right"/>
                <ImageButton
                    android:id="@+id/direction_left"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/size56"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/size12"
                    android:padding="@dimen/size20"
                    android:src="@drawable/ic_led_left"
                    android:background="@drawable/bg_led_direction"
                    android:contentDescription="@string/direction_left"/>
                <ImageButton
                    android:id="@+id/direction_down"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/size56"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/size12"
                    android:padding="@dimen/size20"
                    android:src="@drawable/ic_led_down"
                    android:background="@drawable/bg_led_direction"
                    android:contentDescription="@string/direction_down"/>
                <ImageButton
                    android:id="@+id/direction_up"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/size56"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/size12"
                    android:padding="@dimen/size20"
                    android:src="@drawable/ic_led_up"
                    android:background="@drawable/bg_led_direction"
                    android:contentDescription="@string/direction_up"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size20"
            android:padding="@dimen/size20"
            android:orientation="vertical"
            android:background="@drawable/bg_ad">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/visual_effects"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_size_14"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size16">
                <TextView
                    android:id="@+id/effect_glow"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/size44"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/size0"
                    android:gravity="center"
                    android:text="@string/glow"
                    android:textColor="@color/control_tint"
                    android:textSize="@dimen/text_size_14"
                    android:background="@drawable/bg_led_effect"
                    android:clickable="true"
                    android:focusable="true"/>
                <TextView
                    android:id="@+id/effect_blink"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/size44"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/size8"
                    android:gravity="center"
                    android:text="@string/blink"
                    android:textColor="@color/control_tint"
                    android:textSize="@dimen/text_size_14"
                    android:background="@drawable/bg_led_effect"
                    android:clickable="true"
                    android:focusable="true"/>
                <TextView
                    android:id="@+id/effect_neon"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/size44"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/size8"
                    android:gravity="center"
                    android:text="@string/neon"
                    android:textColor="@color/control_tint"
                    android:textSize="@dimen/text_size_14"
                    android:background="@drawable/bg_led_effect"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
