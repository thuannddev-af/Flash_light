<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:orientation="vertical"
    tools:context=".component.main.MainActivity">

    <TextView
        android:id="@+id/screen_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/size16"
        android:paddingBottom="@dimen/size8"
        android:gravity="center"
        android:fontFamily="@font/plusjakartasans_semibold"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/text_size_18" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/main_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/size72"
        android:background="#202020"
        android:paddingStart="@dimen/size6"
        android:paddingTop="@dimen/size8"
        android:paddingEnd="@dimen/size6"
        android:paddingBottom="@dimen/size8">

        <LinearLayout
            android:id="@+id/tab_flash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_main_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/size26"
                android:layout_height="@dimen/size26"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_flashlight"
                app:tint="@color/control_tint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size8"
                android:duplicateParentState="true"
                android:fontFamily="@font/plusjakartasans_medium"
                android:gravity="center"
                android:text="@string/flashlight_tab"
                android:textColor="@color/control_tint"
                android:textSize="@dimen/text_size_12" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_edge"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_main_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/size26"
                android:layout_height="@dimen/size26"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_edge_off"
                app:tint="@color/control_tint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size8"
                android:duplicateParentState="true"
                android:fontFamily="@font/plusjakartasans_medium"
                android:gravity="center"
                android:text="@string/edge_lighting"
                android:textColor="@color/control_tint"
                android:textSize="@dimen/text_size_12" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_led"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_main_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/size26"
                android:layout_height="@dimen/size26"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_led_off"
                app:tint="@color/control_tint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size8"
                android:duplicateParentState="true"
                android:fontFamily="@font/plusjakartasans_medium"
                android:gravity="center"
                android:text="@string/led"
                android:textColor="@color/control_tint"
                android:textSize="@dimen/text_size_12" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_alert"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_main_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/size26"
                android:layout_height="@dimen/size26"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sos"
                app:tint="@color/control_tint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size8"
                android:duplicateParentState="true"
                android:fontFamily="@font/plusjakartasans_medium"
                android:gravity="center"
                android:text="@string/flash_alert"
                android:textColor="@color/control_tint"
                android:textSize="@dimen/text_size_12" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

