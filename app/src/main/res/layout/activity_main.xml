<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:orientation="vertical"
    tools:context=".component.main.MainActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_32sdp">

        <TextView
            android:id="@+id/screen_title"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:ellipsize="end"
            android:fontFamily="@font/plusjakartasans_semibold"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="64dp"
            android:paddingEnd="64dp"
            android:text="@string/flashlight_tab"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_size_18" />

        <ImageButton
            android:id="@+id/flash_settings_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/setting"
            android:scaleType="center"
            android:src="@drawable/ic_setting"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/main_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.kt.flash.light.led.banner.customview.GlowTabBar
        android:id="@+id/bottom_tabs"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size72"
        android:background="#1A1919"
        android:paddingStart="@dimen/size6"
        android:paddingTop="@dimen/size8"
        android:paddingEnd="@dimen/size6"
        android:paddingBottom="@dimen/size8">

        <LinearLayout
            android:id="@+id/tab_flash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_main_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tvFlash"
                android:layout_width="@dimen/size26"
                android:layout_height="@dimen/size26"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_flashlight"
                app:tint="@color/control_tint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size8"
                android:duplicateParentState="true"
                android:fontFamily="@font/plusjakartasans_medium"
                android:gravity="center"
                android:text="@string/flashlight_tab"
                android:textColor="@color/control_tint"
                android:textSize="@dimen/text_size_12"

                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:focusable="false"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_edge"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_main_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/size26"
                android:layout_height="@dimen/size26"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_edge_off"
                app:tint="@color/control_tint" />

            <TextView
                android:id="@+id/tvEdge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size8"
                android:duplicateParentState="true"
                android:fontFamily="@font/plusjakartasans_medium"
                android:gravity="center"
                android:text="@string/edge_lighting"
                android:textColor="@color/control_tint"
                android:textSize="@dimen/text_size_12"

                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:focusable="false"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_led"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_main_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/size26"
                android:layout_height="@dimen/size26"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_led_off"
                app:tint="@color/control_tint" />

            <TextView
                android:id="@+id/tvLed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size8"
                android:duplicateParentState="true"
                android:fontFamily="@font/plusjakartasans_medium"
                android:gravity="center"
                android:text="@string/led"
                android:textColor="@color/control_tint"
                android:textSize="@dimen/text_size_12"

                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:focusable="false"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_alert"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_main_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/size26"
                android:layout_height="@dimen/size26"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sos"
                app:tint="@color/control_tint" />

            <TextView
                android:id="@+id/tvAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size8"
                android:duplicateParentState="true"
                android:fontFamily="@font/plusjakartasans_medium"
                android:gravity="center"
                android:text="@string/flash_alert"
                android:textColor="@color/control_tint"
                android:textSize="@dimen/text_size_12"

                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:focusable="false"/>
        </LinearLayout>
    </com.kt.flash.light.led.banner.customview.GlowTabBar>
    <FrameLayout
        android:id="@+id/frAdsBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">

        <include layout="@layout/layout_banner_control" />
    </FrameLayout>
</LinearLayout>

