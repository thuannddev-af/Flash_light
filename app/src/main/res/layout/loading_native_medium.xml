<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_container_native"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToOutline="true"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.6"
    app:shimmer_highlight_alpha="1">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/size10">
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/loading_medium_column"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.43" />
        <View
            android:id="@+id/loading_medium_media"
            android:layout_width="0dp"
            android:layout_height="@dimen/size140"
            android:background="@drawable/bg_native_medium_placeholder"
            app:layout_constraintStart_toStartOf="@id/loading_medium_column"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/size8"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/loading_medium_column"
            app:layout_constraintTop_toTopOf="@id/loading_medium_media"
            app:layout_constraintBottom_toBottomOf="@id/loading_medium_media">
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/size16"
                android:background="@drawable/bg_native_medium_placeholder" />
            <View
                android:layout_width="@dimen/size80"
                android:layout_height="@dimen/size10"
                android:layout_marginTop="@dimen/size6"
                android:background="@drawable/bg_native_medium_placeholder" />
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/size10"
                android:layout_marginTop="@dimen/size6"
                android:background="@drawable/bg_native_medium_placeholder" />
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/size10"
                android:layout_marginTop="@dimen/size4"
                android:background="@drawable/bg_native_medium_placeholder" />
        </LinearLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/size48"
            android:layout_marginTop="@dimen/size10"
            android:background="@drawable/bg_native_medium_placeholder"
            app:layout_constraintTop_toBottomOf="@id/loading_medium_media"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>