<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size52"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_bg"
    android:layout_marginTop="32dp"
    android:layout_marginHorizontal="16dp">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnBack"
        android:layout_width="@dimen/size30"
        android:layout_height="@dimen/size30"
        android:src="@drawable/ic_arrow_left"
        android:background="@drawable/background_circle_button_selector"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:autoSizeMaxTextSize="@dimen/size17"
        android:autoSizeMinTextSize="@dimen/size13"
        android:autoSizeTextType="uniform"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="@dimen/text_size_18"
        android:gravity="center"
        android:textColor="@color/white"
        android:text="@string/settings_language"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintEnd_toStartOf="@id/btnAction"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnAction"
        android:layout_width="@dimen/size50"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/save"
        android:singleLine="true"
        android:maxLines="1"
        android:textSize="@dimen/text_size_14"
        android:fontFamily="@font/plusjakartasans_semibold"
        android:clickable="true"
        android:focusable="true"
        android:textColor="@color/color_main"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
