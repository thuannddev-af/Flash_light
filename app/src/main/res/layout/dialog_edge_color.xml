<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_picker"
        android:padding="@dimen/size12"
        android:orientation="vertical">
        <com.kt.flash.light.led.banner.customview.SaturationValueView
            android:id="@+id/color_plane"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size240"
            android:contentDescription="@string/color_plane"/>
        <SeekBar
            android:id="@+id/hue_slider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size40"
            android:max="360"
            android:thumb="@drawable/ic_control"
            android:splitTrack="false"
            android:contentDescription="@string/hue"/>
        <SeekBar
            android:id="@+id/opacity_slider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size40"
            android:max="100"
            android:thumb="@drawable/ic_control"
            android:splitTrack="false"
            android:contentDescription="@string/opacity"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_margin="@dimen/size4"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HEX"
                    android:fontFamily="@font/plusjakartasans_regular"
                    android:textColor="#333333"
                    android:textSize="@dimen/text_size_12"/>
                <EditText
                    android:id="@+id/input_hex"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size44"
                    android:layout_marginTop="@dimen/size6"
                    android:background="@drawable/bg_color_input"
                    android:padding="@dimen/size6"
                    android:singleLine="true"
                    android:inputType="text"
                    android:maxLength="7"
                    android:textColor="#333333"
                    android:textSize="@dimen/text_size_12"
                    android:contentDescription="HEX"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="@dimen/size4"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R"
                    android:fontFamily="@font/plusjakartasans_regular"
                    android:textColor="#333333"
                    android:textSize="@dimen/text_size_12"/>
                <EditText
                    android:id="@+id/input_red"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size44"
                    android:layout_marginTop="@dimen/size6"
                    android:background="@drawable/bg_color_input"
                    android:padding="@dimen/size6"
                    android:singleLine="true"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="#333333"
                    android:textSize="@dimen/text_size_12"
                    android:contentDescription="R"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="@dimen/size4"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="G"
                    android:fontFamily="@font/plusjakartasans_regular"
                    android:textColor="#333333"
                    android:textSize="@dimen/text_size_12"/>
                <EditText
                    android:id="@+id/input_green"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size44"
                    android:layout_marginTop="@dimen/size6"
                    android:background="@drawable/bg_color_input"
                    android:padding="@dimen/size6"
                    android:singleLine="true"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="#333333"
                    android:textSize="@dimen/text_size_12"
                    android:contentDescription="G"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="@dimen/size4"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="B"
                    android:fontFamily="@font/plusjakartasans_regular"
                    android:textColor="#333333"
                    android:textSize="@dimen/text_size_12"/>
                <EditText
                    android:id="@+id/input_blue"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size44"
                    android:layout_marginTop="@dimen/size6"
                    android:background="@drawable/bg_color_input"
                    android:padding="@dimen/size6"
                    android:singleLine="true"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="#333333"
                    android:textSize="@dimen/text_size_12"
                    android:contentDescription="B"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/choose_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size48"
            android:layout_marginTop="@dimen/size12"
            android:gravity="center"
            android:fontFamily="@font/plusjakartasans_semibold"
            android:background="@drawable/bg_button"
            android:text="@string/choose"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_size_16"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
</ScrollView>
