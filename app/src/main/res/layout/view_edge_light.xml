<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/size190">
        <View
            android:id="@+id/color_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_edge_preview"
            android:contentDescription="@string/pick_color"
            android:clickable="true"
            android:focusable="true"/>
        <ImageButton
            android:id="@+id/full_screen"
            android:layout_width="@dimen/size48"
            android:layout_height="@dimen/size48"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/size8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_full"
            android:contentDescription="@string/full_screen"/>
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size20"
        android:padding="@dimen/size16"
        android:background="@drawable/bg_ad"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/brightness"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_size_14"/>
            <TextView
                android:id="@+id/brightness_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="80%"
                android:textColor="#FFD54F"
                android:textSize="@dimen/text_size_14"/>
        </LinearLayout>
        <SeekBar
            android:id="@+id/brightness_slider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size44"
            android:max="100"
            android:progress="80"
            android:thumb="@drawable/ic_control"
            android:splitTrack="false"
            android:progressTint="#FFD54F"
            android:progressBackgroundTint="#36394A"
            android:contentDescription="@string/brightness"/>
    </LinearLayout>
</LinearLayout>
