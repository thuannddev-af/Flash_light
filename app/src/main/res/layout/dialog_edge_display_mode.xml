<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_edit_border_colors"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/edge_mode_title"
        android:fontFamily="@font/plusjakartasans_semibold"
        android:textColor="#151722"
        android:textSize="16sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="@string/edge_mode_description"
        android:fontFamily="@font/plusjakartasans_regular"
        android:textColor="#606A7E" />


    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_edge_display_mode_option"
        android:paddingHorizontal="12dp"
        android:text="@string/edge_mode_home"
        android:textSize="14sp"
        android:fontFamily="@font/plusjakartasans_medium"
        android:textColor="#151722"
        app:thumbTint="@color/edge_mode_switch_thumb"
        app:trackTint="@color/edge_mode_switch_track" />
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/lock"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_edge_display_mode_option"
        android:enabled="false"
        android:paddingHorizontal="12dp"
        android:text="@string/edge_mode_lock"
        android:textSize="14sp"
        android:textColor="#151722"
        android:fontFamily="@font/plusjakartasans_medium"
        app:thumbTint="@color/edge_mode_switch_thumb"
        app:trackTint="@color/edge_mode_switch_track" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:visibility="gone"
        android:text="@string/edge_mode_lock_unavailable"
        android:textColor="#606A7E"
        android:textSize="12sp" />
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_edge_display_mode_option"
        android:paddingHorizontal="12dp"
        android:text="@string/edge_mode_overlay"
        android:textSize="14sp"
        android:fontFamily="@font/plusjakartasans_medium"
        android:textColor="#151722"
        app:thumbTint="@color/edge_mode_switch_thumb"
        app:trackTint="@color/edge_mode_switch_track" />
    <Button
        android:id="@+id/apply"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background= "@drawable/bg_button"
        app:backgroundTint="@null"
        android:text="@string/edge_apply"
        android:textSize="14sp"
        android:fontFamily="@font/plusjakartasans_regular"
        android:textColor="#ffffff" />
    <Button
        android:id="@+id/cancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:text="@string/edit_border_colors_cancel"
        android:textColor="#606A7E" />
</LinearLayout>
