<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/edge_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_mode"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingHorizontal="@dimen/size12">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/enable_led_edge_lighting"
                    android:textColor="@color/white" />

                <ImageView
                    android:id="@+id/edge_toggle_icon"
                    android:layout_width="@dimen/size48"
                    android:layout_height="@dimen/size48"
                    android:importantForAccessibility="no"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_off" />
            </LinearLayout>

            <include
                android:id="@+id/edge_palette"
                layout="@layout/view_led_palette"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size16" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size16"
                android:background="@drawable/bg_mode"
                android:orientation="vertical"
                android:padding="@dimen/size16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/led_edge_border_style"
                    android:textColor="@color/white" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginTop="@dimen/size12">

                    <LinearLayout
                        android:id="@+id/edge_style_groups"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/edge_styles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size8"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size16"
                android:background="@drawable/bg_mode"
                android:orientation="vertical"
                android:padding="@dimen/size16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/edge_run_style"
                    android:textColor="@color/white" />

                <LinearLayout
                    android:id="@+id/edge_run_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size16"
                android:background="@drawable/bg_mode"
                android:orientation="vertical"
                android:padding="@dimen/size16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/edge_border_settings"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/edge_top_radius"
                    android:textColor="@color/white" />
                <SeekBar
                    android:id="@+id/edge_top_radius"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@string/edge_top_radius"
                    android:max="48"
                    android:maxHeight="8dp"
                    android:minHeight="8dp"
                    android:paddingHorizontal="22dp"
                    android:progress="16"
                    android:progressDrawable="@drawable/bg_flash_timing_track"
                    android:saveEnabled="false"
                    android:splitTrack="false"
                    android:thumb="@drawable/bg_flash_timing_thumb" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/edge_bottom_radius"
                    android:textColor="@color/white" />
                <SeekBar
                    android:id="@+id/edge_bottom_radius"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@string/edge_bottom_radius"
                    android:max="48"
                    android:maxHeight="8dp"
                    android:minHeight="8dp"
                    android:paddingHorizontal="22dp"
                    android:progress="16"
                    android:progressDrawable="@drawable/bg_flash_timing_track"
                    android:saveEnabled="false"
                    android:splitTrack="false"
                    android:thumb="@drawable/bg_flash_timing_thumb" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/edge_border_width"
                    android:textColor="@color/white" />
                <SeekBar
                    android:id="@+id/edge_border_width"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@string/edge_border_width"
                    android:max="20"
                    android:maxHeight="8dp"
                    android:minHeight="8dp"
                    android:paddingHorizontal="22dp"
                    android:progress="8"
                    android:progressDrawable="@drawable/bg_flash_timing_track"
                    android:saveEnabled="false"
                    android:splitTrack="false"
                    android:thumb="@drawable/bg_flash_timing_thumb" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/edge_color_speed"
                    android:textColor="@color/white" />
                <SeekBar
                    android:id="@+id/edge_color_speed"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@string/edge_color_speed"
                    android:max="10"
                    android:maxHeight="8dp"
                    android:minHeight="8dp"
                    android:paddingHorizontal="22dp"
                    android:progress="4"
                    android:progressDrawable="@drawable/bg_flash_timing_track"
                    android:saveEnabled="false"
                    android:splitTrack="false"
                    android:thumb="@drawable/bg_flash_timing_thumb" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size16"
                android:background="@drawable/bg_mode"
                android:orientation="vertical"
                android:padding="@dimen/size16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/edge_notch_style"
                    android:textColor="@color/white" />

                <LinearLayout
                    android:id="@+id/edge_notch_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <Button
                android:id="@+id/edge_apply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size16"
                android:backgroundTint="@color/yellow"
                android:text="@string/edge_apply"
                android:textColor="@color/black" />
        </LinearLayout>
    </ScrollView>

    <com.kt.flash.light.led.banner.customview.LedEdgePreviewView
        android:id="@+id/edge_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</FrameLayout>
